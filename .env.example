# ==============================================================================
# Configuración del Entorno - Dashboard de Clipping
# ==============================================================================

# Puerto de escucha del servidor Express
PORT=3000

# Usuario único de administración
ADMIN_USERNAME=admin

# Hash scrypt de la contraseña generado con: node scripts/hash-password.js [tu_password]
# Por defecto para este entorno de desarrollo: clip2026
ADMIN_PASSWORD_HASH=53f8106346f5d013cace759a6f500d0e:17b5c77ddf80a2b9f14ac3450caaec6d7ea5e7bcadfa70525791a636c7388dbb246e500395448359716fffc521539c891846e456537edc504493183f621e9fad

# Secreto criptográfico para firma de tokens de sesión HMAC-SHA256
SESSION_SECRET=clipflow_studio_super_secret_hmac_key_2026_x89a

# Opción A (Recomendada): URL de Google Apps Script Web App (100% gratis, sin tarjeta)
GOOGLE_APPS_SCRIPT_URL=

# Opción B (Avanzada): Clave de API de Google Drive API v3 (Google Cloud Console)
GOOGLE_DRIVE_API_KEY=

